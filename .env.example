# Server-only settings for /api/quote-request. Never prefix these with VITE_.
# Locally: copy this file to .env and fill it in (vercel dev reads .env).
# Deployments: add the same names in Vercel for Production and Preview.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
RESEND_API_KEY=your-resend-api-key
OWNER_EMAIL=you@example.com
# Optional. Defaults to: StoreSidekick <onboarding@resend.dev>
EMAIL_FROM=
